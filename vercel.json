{
  "redirects": [
    {
      "source": "/login",
      "destination": "https://app.aiassistente.com.br/login",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "https://app.aiassistente.com.br/auth/google",
      "permanent": false
    },
    {
      "source": "/auth/google",
      "destination": "https://app.aiassistente.com.br/auth/google",
